{
  "schemaVersion": 1,
  "id": "io.github.johwconst.predatorsense",
  "name": "PredatorSense Lite",
  "version": "1.0.0",
  "author": "johwconst",
  "license": "MIT",
  "description": "Lighting, performance modes and Claude Code LEDs for the Acer Predator PHN16S-71.",
  "repository": "https://github.com/johwconst/omarchy-predatorsense-lite",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Predator",
    "description": "Performance mode, lighting and Claude Code LEDs",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
